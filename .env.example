OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenAI-compatible API base URL (without /chat/completions).
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# For another provider, set its key and a model supporting JSON Schema:
# OPENAI_API_KEY=your-provider-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: pin one model instead of fetching /models.
# OPENAI_MODEL=gpt-4o-mini

# Optional HTTP(S) proxy for server-side API requests (HTTP proxy URL).
# HTTPS_PROXY=http://127.0.0.1:8080
# NO_PROXY=localhost,127.0.0.1,::1
# NODE_USE_ENV_PROXY=0 disables automatic use of proxy settings.
